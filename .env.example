# WhatsApp Business API
WHATSAPP_TOKEN=your_permanent_access_token
WHATSAPP_PHONE_NUMBER_ID=156969910833816
WHATSAPP_BUSINESS_ACCOUNT_ID=162302063631080
WHATSAPP_APP_SECRET=your_app_secret
WHATSAPP_WEBHOOK_VERIFICATION_TOKEN=your_verify_token

# AI for voice calls (WhatsApp + phone): "gemini" (Gemini Live) or "sarvam"
# (Sarvam Saaras v4 speech-to-text -> Sarvam LLM -> Bulbul v4 Flash voice).
VOICE_ENGINE=gemini

# Google Gemini (VOICE_ENGINE=gemini)
GOOGLE_API_KEY=your_gemini_api_key

# Sarvam AI (VOICE_ENGINE=sarvam) — key from dashboard.sarvam.ai
SARVAM_API_KEY=
# Voice persona (Bulbul v4 Flash; see Sarvam's Voices guide), e.g.
# simran_enhi_customer, ishita_enhi_customer, ritu_hi_customer_warm, neha_en_customer
SARVAM_TTS_SPEAKER=simran_enhi_customer
SARVAM_TTS_LANGUAGE=hi-IN
SARVAM_TTS_PACE=1.0
# Words callers say that speech-to-text should spell right (comma-separated)
SARVAM_KEYTERMS=
# Model overrides (defaults shown)
# SARVAM_STT_MODEL=saaras:v4
# SARVAM_LLM_MODEL=sarvam-105b-conversations
# SARVAM_TTS_MODEL=bulbul:v4-flash

# --- Voice call tuning (optional — sensible defaults if unset) ---
# Turn-taking: "gemini" (default) = Gemini Live's fast native server-side VAD,
#   tuned for noise; Silero runs locally for barge-in. Low latency — recommended.
#   "smart" = Pipecat Silero + Smart Turn v3 own turns (Gemini VAD disabled).
#   NOTE: "smart" added several seconds of latency in testing — keep "gemini".
VOICE_TURN_MODE=gemini
# Silero VAD sensitivity — raise to ignore more background noise (0..1).
VAD_CONFIDENCE=0.8
VAD_MIN_VOLUME=0.7
VAD_START_SECS=0.2
VAD_STOP_SECS=0.2
# Gemini server-VAD silence window in ms. LEAVE BLANK to use Gemini's native
# default (recommended) — overriding the VAD made it drop replies on short speech.
GEMINI_SILENCE_MS=
# Seconds to wait after the caller pauses before treating their turn as finished.
USER_SPEECH_TIMEOUT=0.6
# Disable Gemini "thinking" for faster first replies (set false to re-enable).
GEMINI_DISABLE_THINKING=true
# Cached instant greeting clip. Default OFF — it makes Gemini wait on a turn
# handshake and can mute the whole call. The dynamic greeting (~1.2s) is reliable.
GREETING_ENABLED=false
GREETING_TEXT=
GREETING_TTS_VOICE=shimmer
GREETING_TTS_MODEL=gpt-4o-mini-tts

# --- VoiceLink phone calls (Indian number) — see docs/VOICELINK_CALLING.md ---
# Leave VOICELINK_URL_TOKEN blank to keep phone calling disabled.
# Public HTTPS address of this server (VoiceLink connects to wss://<this>/voicelink/ws/...)
PUBLIC_BASE_URL=https://wa.yourdomain.com
# Secret path segment for VoiceLink's media + webhook URLs:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
VOICELINK_URL_TOKEN=
# API token from the VoiceLink portal (or username + password instead)
VOICELINK_API_TOKEN=
VOICELINK_USERNAME=
VOICELINK_PASSWORD=
# Only if logged in as a reseller acting for a client account
VOICELINK_CLIENT_ID=
# The number exactly as VoiceLink lists it under Phone Numbers, e.g. 918045XXXXXX
VOICELINK_DID=
VOICELINK_BOT_NAME=AI Receptionist
# Mobile the AI transfers to when a caller asks for a human (blank = offer a callback)
VOICELINK_TRANSFER_NUMBER=
# Approved WhatsApp template sent after phone calls ({{1}} = caller name).
# Blank = free-form follow-up, which only reaches callers who messaged us in the last 24h.
VOICELINK_FOLLOWUP_TEMPLATE=
VOICELINK_FOLLOWUP_TEMPLATE_LANG=en
# Simultaneous outbound campaign calls — set to the number of VoiceLink channels you own
VOICELINK_MAX_CONCURRENT_CALLS=1

# OpenAI (for text chatbot)
OPENAI_API_KEY=your_openai_api_key

# Chatwoot Integration (forward messages to Chatwoot inbox)
CHATWOOT_WEBHOOK_URL=https://wapp.munipramansagar.net/webhooks/whatsapp/+916207292062

# n8n Integration (post-call/chat hooks)
N8N_CALL_HOOK_URL=https://workflow.munipramansagar.net/webhook/call-summary
N8N_CHAT_HOOK_URL=https://workflow.munipramansagar.net/webhook/chat-summary

# Razorpay (for order payments — optional)
RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Dashboard Security
DASHBOARD_PASSWORD=your_secure_password
WEBHOOK_SECRET=your_webhook_secret

# Greetings Staff Page (separate login for greeting campaign staff)
GREETINGS_PASSWORD=your_greetings_password

# Rooms Staff Page (separate login for room allotment/confirmation staff)
ROOMS_PASSWORD=your_rooms_password

# AI Toggle (set to false to disable AI chatbot system-wide, can also toggle via dashboard API)
AI_ENABLED=true

# Marketing Messages API (MM Lite) — uses Meta's AI for better delivery of marketing templates
USE_MARKETING_API=true

# Service key for server-to-server callers (OneHub ERP → POST /api/whatsapp/send).
# Generate any long random string, e.g.: python -c "import secrets; print(secrets.token_urlsafe(32))"
WA_API_KEY=

# Web Push notifications (Android PWA). Leave blank to disable push entirely.
# Generate a key pair once:  python generate_vapid_keys.py
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.org

# Server
PORT=7860
ENVIRONMENT=production

# Branding (white-label — customise for your organisation)
APP_NAME=Gunayatan WhatsApp Platform
APP_SHORT_NAME=Gunayatan WhatsApp
BUSINESS_NAME=Gunayatan
BUSINESS_SHORT=गुणायतन
BUSINESS_CITY=Shikharji
SUPPORT_PHONE=+91 99340 50345

# Campaign Rate Limiting (messages per minute)
CAMPAIGN_RATE_LIMIT=100

# MinIO / S3 Storage (optional — if not configured, media is not downloaded)
MINIO_ENDPOINT=https://minio.yourdomain.com
MINIO_ACCESS_KEY=your_access_key
MINIO_SECRET_KEY=your_secret_key
MINIO_BUCKET=whatsapp-media
MINIO_REGION=us-east-1
MEDIA_EXPIRY_DAYS=7

# Google Sheets Integration (for dharamshala room lookup — optional)
GOOGLE_SHEETS_CREDENTIALS_JSON=path/to/service-account.json
DHARAMSHALA_SHEET_ID=your_google_sheet_id
